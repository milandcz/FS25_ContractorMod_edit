<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI name="contractorModSettingsFrame">
    <GuiProfiles>
        <Profile name="cmHeaderContainer" extends="baseReference" with="anchorTopStretchingX">
            <height value="32px"/>
            <position value="0px -100px"/>
            <absoluteSizeOffset value="15px 0px"/>
            <imageColor value="$preset_fs25_colorGreyDark_50"/>
        </Profile>
        <Profile name="cmWorkersLayout" extends="emptyPanel" with="anchorStretchingYLeft pivotTopLeft">
            <position value="0px -140px"/>
            <absoluteSizeOffset value="15px 160px"/>
        </Profile>
        <Profile name="cmWorkerRow" extends="baseReference" with="anchorTopStretchingX">
            <height value="32px"/>
            <imageColor value="$preset_fs25_colorGrey"/>
        </Profile>
        <Profile name="cmWorkerRowA" extends="cmWorkerRow">
            <imageColor value="$preset_fs25_colorGrey"/>
        </Profile>
        <Profile name="cmWorkerRowB" extends="cmWorkerRow">
            <imageColor value="$preset_fs25_colorGreyDark_50"/>
        </Profile>
        <Profile name="cmHeaderCell" extends="baseReference">
            <height value="32px"/>
            <imageColor value="0 0 0 0"/>
            <textSize value="15px"/>
            <textBold value="true"/>
            <textUpperCase value="true"/>
            <textColor value="$preset_colorWhite_50"/>
            <textAlignment value="left"/>
            <textDisabledColor value="$preset_colorDisabled"/>
        </Profile>
        <Profile name="cmRowText" extends="baseReference" with="anchorStretchingYLeft">
            <textBold value="false"/>
            <textSize value="15px"/>
            <textColor value="$preset_fs25_colorMainLight"/>
            <textDisabledColor value="$preset_colorDisabled"/>
        </Profile>
        <Profile name="cmActionButton" extends="baseReference" with="anchorTopLeft">
            <height value="28px"/>
            <imageColor value="0 0 0 0"/>
            <textFocusedColor value="$preset_fs25_colorMainHighlight"/>
            <textHighlightedColor value="$preset_fs25_colorMainHighlight"/>
            <textSize value="14px"/>
            <textBold value="true"/>
            <textAlignment value="left"/>
            <textColor value="$preset_fs25_colorMainLight"/>
            <textDisabledColor value="$preset_colorDisabled"/>
        </Profile>
    </GuiProfiles>
    <GuiElement profile="fs25_menuContainer">
        <GuiElement profile="fs25_menuHeaderPanel">
            <Bitmap profile="fs25_menuHeaderIconBg">
                <Bitmap id="headerIcon" profile="fs25_menuHeaderIcon" size="50px 50px"/>
            </Bitmap>
            <Text profile="fs25_menuHeaderTitle" text="$l10n_ContractorMod_SETTINGS_TITLE" size="500px 32px"/>
        </GuiElement>
        <Bitmap profile="cmHeaderContainer">
            <Text profile="cmHeaderCell" position="5px 0px" size="240px 32px" text="$l10n_ContractorMod_COL_WORKER"/>
            <Text profile="cmHeaderCell" position="255px 0px" size="280px 32px" text="$l10n_ContractorMod_LOCATION"/>
            <Text profile="cmHeaderCell" position="545px 0px" size="360px 32px" text="$l10n_ContractorMod_STATE"/>
            <Text profile="cmHeaderCell" position="915px 0px" size="130px 32px" text="$l10n_ContractorMod_REMAINING"/>
            <Text profile="cmHeaderCell" position="1055px 0px" size="270px 32px" text="$l10n_ContractorMod_COL_ACTIONS"/>
        </Bitmap>
        <BoxLayout profile="cmWorkersLayout" id="workersLayout" flowDirection="vertical" numFlows="1">
            <Bitmap id="workerRowTemplateA" profile="cmWorkerRowA" visible="false">
                <Button name="renameButton" profile="cmActionButton" position="5px 2px" size="240px 28px" text=""/>
                <Text name="locationText" profile="cmRowText" position="255px 4px" size="280px 24px"/>
                <Text name="stateText" profile="cmRowText" position="545px 4px" size="360px 24px"/>
                <Text name="remainingText" profile="cmRowText" position="915px 4px" size="130px 24px"/>
                <Button name="switchButton" profile="cmActionButton" position="1055px 2px" size="130px 28px" text="$l10n_ContractorMod_SWITCH"/>
                <Button name="fireButton" profile="cmActionButton" position="1195px 2px" size="130px 28px" text="$l10n_ContractorMod_FIRE"/>
            </Bitmap>
            <Bitmap id="workerRowTemplateB" profile="cmWorkerRowB" visible="false">
                <Button name="renameButton" profile="cmActionButton" position="5px 2px" size="240px 28px" text=""/>
                <Text name="locationText" profile="cmRowText" position="255px 4px" size="280px 24px"/>
                <Text name="stateText" profile="cmRowText" position="545px 4px" size="360px 24px"/>
                <Text name="remainingText" profile="cmRowText" position="915px 4px" size="130px 24px"/>
                <Button name="switchButton" profile="cmActionButton" position="1055px 2px" size="130px 28px" text="$l10n_ContractorMod_SWITCH"/>
                <Button name="fireButton" profile="cmActionButton" position="1195px 2px" size="130px 28px" text="$l10n_ContractorMod_FIRE"/>
            </Bitmap>
            <Bitmap id="hireRowTemplate" profile="cmWorkerRow" visible="false">
                <Button name="hireButton" profile="cmActionButton" position="1195px 2px" size="130px 28px" text="$l10n_ContractorMod_HIRE"/>
            </Bitmap>
        </BoxLayout>
    </GuiElement>
</GUI>
